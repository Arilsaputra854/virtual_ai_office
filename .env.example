# Alamat server
HOST=127.0.0.1
PORT=3000

# API key provider (dipakai lewat "apiKeyEnv" di data/office.json).
# Key tidak pernah dikirim ke browser — semua request lewat proxy server ini.
NINEROUTER_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Opsional: kunci UI dengan password (HTTP Basic Auth, username bebas)
OFFICE_PASSWORD=

# Opsional: aktifkan tool fetch_url (agen boleh membuka halaman web publik)
TOOLS_HTTP=0
